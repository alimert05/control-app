<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Classic Bluetooth permissions only: targetSdk is 27, well below the API 31
      threshold where BLUETOOTH_SCAN/BLUETOOTH_CONNECT replace these, so the
      legacy model applies and no runtime request is needed for them.
      ACCESS_COARSE_LOCATION IS a dangerous permission on API 23+ and BLE scan
      results are silently empty without it being granted at runtime — see
      ConnectActivity.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      TASK-004: RECEIVE_BOOT_COMPLETED is a normal permission, granted at
      install time on every API level — required so BootReceiver can hear
      BOOT_COMPLETED at all.
      WRITE_SETTINGS is a "special" permission: declaring it here does NOT
      grant it. The user must explicitly approve it on the
      ACTION_MANAGE_WRITE_SETTINGS system screen (see BrightnessController) —
      it is never requested through the normal runtime-permission dialog and
      never assumed to be granted.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".AliControlApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AliControl"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ConnectActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <activity
            android:name=".ui.DeviceSettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout" />

        <!--
          BOOT_COMPLETED is exempt from Android 8's implicit-broadcast manifest
          restrictions, so a plain manifest-declared receiver still works here
          without needing a foreground service or JobScheduler workaround.
        -->
        <receiver
            android:name=".kiosk.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
